<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ (API 31).

         The system splash shows the LCS logo (windowSplashScreenAnimatedIcon)
         so a logo is on screen from the very first frame, while the app loads.
         It can only show an icon, never text — so the wordmark is added by the
         in-app overlay (LcsBrandedSplashOverlay), which continues on the same
         white field with the same logo plus "Liberty Chat".

         android:windowSplashScreenBrandingImage is deliberately NOT used: it is
         API 31+ only and androidx core-splashscreen does not emulate it, so it
         would differ across Android versions. -->
    <style name="Theme.Columba.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Columba</item>
    </style>
</resources>
